---
interface Props { label?: string; code: string; }
const { label, code } = Astro.props;
---
<div class="snip">
  {label && <span class="meta snip__label">{label}</span>}
  <pre class="snip__code"><code>{code}</code></pre>
</div>
<style>
  .snip { display: grid; gap: 0.45rem; }
  .snip__label { color: var(--ink-3); }
  .snip__code {
    margin: 0;
    padding: 0.85rem 1rem;
    background: var(--paper-sunk);
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-chip);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.65;
    color: var(--ink-2);
    white-space: pre;
  }
</style>
