---
/**
 * Drawn graph paper. Generated at build time from the same wobble engine as
 * the diagrams, so a tile that needs visual weight gets it from the site's own
 * language rather than from a stock gradient.
 */
import { roughLine } from '@/lib/rough';

interface Props { seed?: number; gap?: number; w?: number; h?: number; }
const { seed = 909, gap = 26, w = 420, h = 320 } = Astro.props;

let s = seed;
const next = () => (s = (s * 1103515245 + 12345) % 2147483647);

const lines: string[] = [];
for (let x = gap; x < w; x += gap) lines.push(roughLine(x, -4, x, h + 4, next(), { wobble: 1.1, passes: 1 }));
for (let y = gap; y < h; y += gap) lines.push(roughLine(-4, y, w + 4, y, next(), { wobble: 1.1, passes: 1 }));
---
<svg class="paper-grid" viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  {lines.map((d) => <path d={d} />)}
</svg>
<style>
  .paper-grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.4;
  }
  .paper-grid path { stroke: var(--ink-3); stroke-width: 0.8; fill: none; opacity: 0.35; }
</style>
