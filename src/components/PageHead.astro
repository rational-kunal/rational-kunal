---
interface Props { kicker?: string; title: string; lede?: string; }
const { kicker, title, lede } = Astro.props;
---
<header class="phead">
  <div class="wrap">
    {kicker && <p class="eyebrow">{kicker}</p>}
    <h1 class="display phead__title">{title}</h1>
    {lede && <p class="lede phead__lede">{lede}</p>}
    <slot />
  </div>
</header>
<style>
  .phead {
    padding-top: clamp(2.5rem, 1.5rem + 5vw, 5rem);
    padding-bottom: clamp(2.5rem, 2rem + 4vw, 4.5rem);
    display: grid;
    gap: 1.1rem;
  }
  .phead .wrap { display: grid; justify-items: start; gap: 1.1rem; }
  .phead__title {
    font-size: clamp(2.3rem, 1rem + 4.2vw, 4.1rem);
    max-width: 20ch;
  }
  .phead__lede { max-width: 54ch; }
</style>
