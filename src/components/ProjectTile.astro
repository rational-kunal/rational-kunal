---
/**
 * A bento cell. Small surface, so it carries the headline facts and one visual.
 *
 * The visual picks itself, in this order:
 *   1. a real screenshot from the project's repo
 *   2. a three-step mini flow, when there is no screenshot
 *   3. drawn graph paper, when there is neither
 * A full diagram is never used here; it is unreadable at this width and lives
 * on the full-width surfaces instead.
 */
import type { Project } from '@/data/projects';
import { kindLabel } from '@/data/projects';
import Chips from './Chips.astro';
import Stars from './Stars.astro';
import Icon from './Icon.astro';
import Shot from './Shot.astro';
import MiniFlow from './MiniFlow.astro';
import PaperGrid from './PaperGrid.astro';

interface Props {
  project: Project;
  span?: number;
  /** Force the paper texture even when a visual exists. Rarely needed. */
  tone?: 'auto' | 'grid';
}
const { project: p, span = 4, tone = 'auto' } = Astro.props;

const visual = tone === 'grid' ? 'grid' : p.shot ? 'shot' : p.mini ? 'mini' : 'grid';
/* A tile this wide reads badly as one tall column, so its body goes side by side. */
const wide = span >= 10;
const seed = [...p.slug].reduce((a, c) => a + c.charCodeAt(0), 0);
---

<article
  class:list={['tile', 'plate', 'reveal', `tile--${visual}`, { 'tile--wide': wide }]}
  style={`--span:${span}`}
>
  <div class="plate__core tile__core">
    {visual === 'grid' && <PaperGrid seed={seed * 13} />}

    <div class="tile__body">
      <div class="tile__words">
        <div class="tile__top">
          <span class="meta">{kindLabel[p.kind]}</span>
          <Stars count={p.stars} />
        </div>

        <h3 class="h3 tile__name">{p.name}</h3>
        <p class="tile__tag">{p.tagline}</p>

        <Chips items={p.stack.slice(0, 4)} class="tile__chips" />

        <div class="tile__acts">
        <a class="btn btn--plain tile__btn" href={p.repo} rel="noopener" target="_blank">
          Source
          <span class="btn__cap" aria-hidden="true"><Icon name="github-logo" size={13} /></span>
        </a>
          {p.demo && (
            <a class="btn btn--plain tile__btn" href={p.demo} rel="noopener" target="_blank">
              Try it
              <span class="btn__cap" aria-hidden="true"><Icon name="arrow-up-right" size={13} /></span>
            </a>
          )}
        </div>
      </div>

      {visual === 'shot' && p.shot && (
        <Shot src={p.shot.src} dark={p.shot.dark} alt={p.shot.alt} fit="crop" class="tile__shot" />
      )}
      {visual === 'mini' && p.mini && (
        <div class="tile__mini"><MiniFlow steps={p.mini} seed={seed} /></div>
      )}
    </div>
  </div>
</article>

<style>
  .tile { grid-column: span var(--span); }
  .tile__core {
    position: relative;
    overflow: hidden;
    padding: clamp(1.1rem, 2.2vw, 1.7rem);
  }
  .tile--grid .tile__core { background: var(--paper-sunk); }
  .tile__body { position: relative; display: flex; flex-direction: column; gap: 0.95rem; height: 100%; }
  .tile__words { display: flex; flex-direction: column; gap: 0.75rem; flex: 1; }
  .tile__top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .tile__name { letter-spacing: -0.025em; }
  .tile__tag { color: var(--ink-2); font-size: var(--t-small); line-height: 1.6; max-width: 46ch; }

  .tile__shot { margin-top: auto; }
  .tile__mini {
    padding: 0.5rem 0.3rem;
    border-radius: var(--r-chip);
    background: var(--paper-sunk);
    border: 1px solid var(--rule-soft);
  }
  .tile--grid .tile__mini { background: var(--paper-raise); }

  .tile__mini :global(svg) { max-width: 400px; margin-inline: auto; }
  .tile__chips { margin-top: auto; padding-top: 0.6rem; }
  .tile__acts { display: flex; gap: 0.45rem; flex-wrap: wrap; }
  .tile__btn { font-size: 0.82rem; padding-block: 0.46rem; }

  /* Wide tiles: words on the left, the visual holding its own column. */
  @media (min-width: 901px) {
    .tile--wide .tile__body {
      flex-direction: row;
      align-items: stretch;
      gap: clamp(1.5rem, 3vw, 2.75rem);
    }
    .tile--wide .tile__words { max-width: 34rem; }
    .tile--wide .tile__shot { margin-top: 0; width: 15rem; flex: none; }
    .tile--wide .tile__mini {
      margin-top: 0;
      flex: 1;
      display: grid;
      align-content: center;
      min-width: 18rem;
    }
  }

  @media (max-width: 900px) {
    .tile { grid-column: 1 / -1; }
  }
</style>
