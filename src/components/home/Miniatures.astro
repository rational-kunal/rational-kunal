---
/**
 * The top of the page: six small scenes, each one showing what a project does
 * rather than saying it. A button presses into its hard shadow, SwiftUI-style
 * code renders into a terminal and only the changed cells are rewritten, two
 * peers meet through a server that then steps aside, a feed stops after three
 * posts and makes you wait, a price ticks down, video segments stream into a
 * screen.
 *
 * All CSS, no script. Each tile is a plain link down to that project in the
 * Work section. The un-animated state is a meaningful still frame, and motion
 * only runs when the visitor has not asked for less of it.
 *
 * The scenes are hand-made, not screenshots: if a project changes enough that
 * its scene lies, edit it here.
 */
import { findProject, projectHref } from '@/data/projects';
import { url } from '@/lib/url';

/** A scene's link and star count. A slug that is not in projects.ts fails the build. */
function scene(slug: string) {
  const p = findProject(slug);
  if (!p) throw new Error(`Miniatures: no project with slug "${slug}"`);
  return { href: url(projectHref(p)), stars: p.stars };
}
const neo = scene('neobrutalism');
const blink = scene('blinkui');
const call = scene('oneonone');
const ig = scene('nottheinstagram');
const keem = scene('keemat');
const chal = scene('chalchitra');
---

<section class="bento" aria-label="Six projects, each drawn doing what it does">

  <!-- 1. NeoBrutalism -->
  <a class="tile t-neo" href={neo.href} aria-label={`NeoBrutalism, ${neo.stars} stars. Read about it below.`}>
    <svg class="frame" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M1.6 2.2 C30 1.2 70 2.8 98.4 1.5 C99.2 30 97.9 70 98.6 98.3 C70 99.1 30 97.7 1.8 98.6 C1 70 2.3 30 1.6 2.2 Z"/><path d="M2.1 1.6 C35 2.4 66 1.1 98.9 2.3 C98.1 34 99.3 66 98 98.9 C66 98.2 34 99.4 1.2 98 C2.2 66 0.9 34 2.1 1.6 Z"/></svg>
    <span class="stage" aria-hidden="true">
      <span class="nb">
        <span class="nb-card"><i></i><i></i><i></i><i></i></span>
        <span class="nb-tog"></span>
        <span class="nb-chk"><svg viewBox="0 0 30 30"><path class="mk" stroke-width="3.2" d="M7 15.5 L12.5 21 L23 9"/></svg></span>
        <span class="nb-btn">Tap</span>
        <svg class="nb-cur" viewBox="0 0 22 26"><path d="M2 2 L2.4 20.5 L7.3 15.8 L10.6 23.6 L14 22.1 L10.7 14.5 L17.6 14 Z"/></svg>
      </span>
    </span>
    <span class="label"><span class="name">NeoBrutalism</span><span class="stars"><b>&#9733;</b> {neo.stars}</span></span>
  </a>

  <!-- 2. BlinkUI -->
  <a class="tile t-blink" href={blink.href} aria-label={`BlinkUI, ${blink.stars} stars. Read about it below.`}>
    <svg class="frame" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M1.4 2.6 C30 1.4 70 3 98.6 1.8 C99 30 98.2 70 98.4 97.9 C70 98.8 30 97.4 1.5 98.7 C1.1 70 2.5 30 1.4 2.6 Z"/><path d="M2 1.4 C36 2.6 64 0.9 98.8 2.1 C98.3 36 99.1 64 98.1 98.8 C64 98 36 99.3 1.3 98.2 C2.4 64 1 36 2 1.4 Z"/></svg>
    <span class="stage" aria-hidden="true">
      <span class="bk">
        <span class="bk-code">
          <span><b>HStack</b> {'{'}</span>
          <span>&nbsp; <b>Button</b>(<i>"Blue pill"</i>)</span>
          <span>&nbsp; <b>Button</b>(<i>"Red pill"</i>)</span>
          <span>{'}'}</span>
        </span>
        <svg class="bk-arrow" viewBox="0 0 30 14"><path class="mk" stroke-width="1.7" d="M2 7.4 Q14 6.2 26 7 M20.5 2.6 L26.4 7 L20.8 11.6"/></svg>
        <span class="term">
          <span class="term-bar"><i></i><i></i><i></i></span>
          <span class="bk-scr">
            <span class="bk-line">Last chance.</span>
            <span class="bk-swap">
              <span class="bk-btns"><span class="bk-btn bk-blue">Blue pill</span><span class="bk-btn bk-red">Red pill</span></span>
              <span class="bk-matrix">The Matrix is everywhere.</span>
              <span class="bk-dirty"></span>
            </span>
          </span>
        </span>
      </span>
    </span>
    <span class="label"><span class="name">BlinkUI</span><span class="stars"><b>&#9733;</b> {blink.stars}</span></span>
  </a>

  <!-- 3. OneOnOne -->
  <a class="tile t-call" href={call.href} aria-label="OneOnOne. Read about it below.">
    <svg class="frame" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M1.8 1.9 C30 2.8 70 1.2 98.2 2.4 C98.9 30 97.6 70 98.7 98.1 C70 97.6 30 99 1.6 98.4 C2.4 70 1.2 30 1.8 1.9 Z"/><path d="M1.2 2.4 C34 1.3 66 2.7 98.7 1.4 C98 34 99.4 66 98.2 98.7 C66 99.2 34 97.9 2 98.9 C1 66 2.6 34 1.2 2.4 Z"/></svg>
    <span class="stage" aria-hidden="true">
      <svg viewBox="0 0 200 112">
        <g class="srv">
          <path class="ink" d="M86.5 9.2 Q100 8.4 114 9.4 L113.6 29.1 Q100 29.8 86.2 28.7 Z" style="fill:var(--paper-sunk)"/>
          <path class="soft" d="M91 16 H109 M91 22 H104"/>
          <circle class="mk-f" cx="108" cy="22" r="1.6"/>
          <path class="soft" stroke-dasharray="3 4" d="M33 79 L96 30.5"/>
          <path class="soft" stroke-dasharray="3 4" d="M104 30.5 L167 79"/>
        </g>
        <path class="mk direct" stroke-width="2.6" pathLength="1" d="M37 86 Q70 97.5 100 96 T163 86"/>
        <circle class="mk halo" cx="30" cy="84" r="8" stroke-width="1.4"/>
        <circle class="mk halo halo-b" cx="170" cy="84" r="8" stroke-width="1.4"/>
        <circle class="ink-f" cx="30" cy="84" r="7.5"/>
        <circle class="ink-f" cx="170" cy="84" r="7.5"/>
        <circle cx="30" cy="84" r="2.6" style="fill:var(--paper-raise)"/>
        <circle cx="170" cy="84" r="2.6" style="fill:var(--paper-raise)"/>
        <circle class="mk-f pk pk-a" cx="32" cy="80" r="3.4"/>
        <circle class="mk-f pk pk-b" cx="168" cy="80" r="3.4"/>
      </svg>
    </span>
    <span class="label"><span class="name">OneOnOne</span><span class="stars">WebRTC</span></span>
  </a>

  <!-- 4. NotTheInstagram -->
  <a class="tile t-ig" href={ig.href} aria-label="NotTheInstagram. Read about it below.">
    <svg class="frame" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M2.3 1.5 C30 2.2 70 1 97.8 2 C98.9 30 97.5 70 98.5 98.6 C70 97.9 30 99.2 1.4 98.1 C2.6 70 1.1 30 2.3 1.5 Z"/><path d="M1.5 2.1 C34 1 66 2.5 98.6 1.3 C97.9 34 99 66 98 98.2 C66 99.1 34 98 2.1 98.8 C1.2 66 2.4 34 1.5 2.1 Z"/></svg>
    <span class="stage" aria-hidden="true">
      <svg viewBox="0 0 120 164">
        <defs><clipPath id="mini-screen"><rect x="35.5" y="17" width="49" height="128" rx="3"/></clipPath></defs>
        <path class="ink" style="fill:var(--paper)" stroke-width="1.8" d="M41 8.2 Q31.6 8 32.3 17.4 L33 145 Q32.8 154.4 41.5 153.8 L79.6 154.3 Q88.6 154 87.8 145 L88.2 17.2 Q88.5 8.6 79.4 8 Z"/>
        <path class="ink" d="M54 12.4 H66"/>
        <g clip-path="url(#mini-screen)">
          <!-- three posts, then the wait under them -->
          <g class="ig-feed">
            <rect x="38" y="21" width="44" height="30" rx="3" class="sunk"/>
            <rect x="38" y="21" width="44" height="30" rx="3" class="ink"/>
            <path class="ink" d="M40 47 L50 37 L56 43 L62 35 L80 47"/>
            <circle class="ink-f" cx="47" cy="29" r="2.4"/>
            <rect x="38" y="57" width="44" height="30" rx="3" class="sunk"/>
            <rect x="38" y="57" width="44" height="30" rx="3" class="ink"/>
            <path class="ink" d="M41 83 L53 72 L60 78 L66 73 L79 83"/>
            <rect x="38" y="93" width="44" height="30" rx="3" class="sunk"/>
            <rect x="38" y="93" width="44" height="30" rx="3" class="ink"/>
            <circle class="ink-f" cx="71" cy="102" r="2.4"/>
            <path class="ink" d="M40 118 L52 108 L60 114 L80 118"/>
            <circle class="soft" cx="60" cy="154" r="9"/>
            <circle class="mk ig-wait" stroke-width="2.6" pathLength="1" cx="60" cy="154" r="9" transform="rotate(-90 60 154)"/>
            <path class="soft" d="M47 173 H73 M51 178 H69"/>
          </g>
          <!-- the usage label: time spent today -->
          <rect x="45" y="135.5" width="30" height="6" rx="3" style="fill:var(--paper)"/>
          <rect x="45" y="135.5" width="30" height="6" rx="3" class="soft"/>
          <path class="mk" stroke-width="1.4" d="M49 138.5 H57"/>
        </g>
      </svg>
    </span>
    <span class="label"><span class="name">NotThe<wbr />Instagram</span><span class="stars">.ipa</span></span>
  </a>

  <!-- 5. keemat -->
  <a class="tile t-keem" href={keem.href} aria-label="keemat. Read about it below.">
    <svg class="frame" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M1.7 2.4 C30 1.3 70 2.9 98.3 1.7 C99.1 30 97.7 70 98.8 98.2 C70 99 30 97.5 1.4 98.5 C2.2 70 1.1 30 1.7 2.4 Z"/><path d="M2.2 1.3 C34 2.5 66 1 98.9 2.2 C98 34 99.2 66 98.3 98.9 C66 98 34 99.3 1.1 98.1 C2.3 66 1 34 2.2 1.3 Z"/></svg>
    <span class="stage" aria-hidden="true">
      <span class="km">
        <span class="km-top">
          <span class="km-thumb"></span>
          <span class="km-bell">
            <svg viewBox="0 0 18 18"><path class="ink" d="M4 13 Q4.6 11.6 4.6 8.6 Q4.8 4.2 9 4 Q13.3 4.2 13.4 8.6 Q13.4 11.6 14.2 13 Z M7.4 15.2 Q9 16.6 10.6 15.2"/></svg>
            <span class="km-dot"></span>
          </span>
        </span>
        <span class="km-price">&#8377;<span class="km-win"><span class="km-roll"><span>2,499</span><span>2,349</span><span>2,199</span><span>1,899</span></span></span><small>2,499</small></span>
        <svg class="km-line" viewBox="0 0 140 34" preserveAspectRatio="none">
          <path class="soft" stroke-dasharray="2 3" d="M2 32.5 H138"/>
          <path class="ink km-path" pathLength="1" d="M2 5 H38 Q39.5 5.2 39.6 7 V12.4 H74 Q75.6 12.6 75.5 14.4 V19.6 H104 Q105.5 19.8 105.4 21.4 V27.5 H137"/>
          <circle class="mk-f km-end" cx="137" cy="27.5" r="3"/>
        </svg>
      </span>
    </span>
    <span class="label"><span class="name">keemat</span><span class="stars">iOS</span></span>
  </a>

  <!-- 6. ChalChitra -->
  <a class="tile t-chal" href={chal.href} aria-label="ChalChitra. Read about it below.">
    <svg class="frame" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M1.5 1.8 C30 2.6 70 1.1 98.5 2.3 C98.8 30 97.6 70 98.4 98.4 C70 97.8 30 99.1 1.9 98.2 C1.1 70 2.6 30 1.5 1.8 Z"/><path d="M2.4 2.2 C36 1.1 64 2.6 98 1.4 C99.1 36 97.9 64 98.9 98 C64 99 36 97.8 1.3 98.9 C2.1 64 1.2 36 2.4 2.2 Z"/></svg>
    <span class="stage" aria-hidden="true">
      <svg viewBox="0 0 250 100">
        <defs><clipPath id="mini-pipe"><rect x="0" y="20" width="136" height="60"/></clipPath></defs>
        <text x="2" y="30" style="font: 500 9px var(--font-mono); fill: var(--ink-3)">.m3u8</text>
        <path class="soft" stroke-dasharray="2 4" d="M2 60 H130"/>
        <g clip-path="url(#mini-pipe)">
          <g class="segbox" style="--i:0"><rect x="4" y="41" width="17" height="17" rx="2.5" class="sunk"/><rect x="4" y="41" width="17" height="17" rx="2.5" class="ink"/><path class="soft" d="M8 47 H17 M8 52 H14"/></g>
          <g class="segbox" style="--i:1"><rect x="4" y="41" width="17" height="17" rx="2.5" class="sunk"/><rect x="4" y="41" width="17" height="17" rx="2.5" class="ink"/><path class="soft" d="M8 47 H17 M8 52 H14"/></g>
          <g class="segbox" style="--i:2"><rect x="4" y="41" width="17" height="17" rx="2.5" class="mk-f"/><rect x="4" y="41" width="17" height="17" rx="2.5" class="ink"/></g>
          <g class="segbox" style="--i:3"><rect x="4" y="41" width="17" height="17" rx="2.5" class="sunk"/><rect x="4" y="41" width="17" height="17" rx="2.5" class="ink"/><path class="soft" d="M8 47 H17 M8 52 H14"/></g>
          <g class="segbox" style="--i:4"><rect x="4" y="41" width="17" height="17" rx="2.5" class="sunk"/><rect x="4" y="41" width="17" height="17" rx="2.5" class="ink"/><path class="soft" d="M8 47 H17 M8 52 H14"/></g>
        </g>
        <!-- the screen -->
        <defs><clipPath id="mini-tv"><rect x="140" y="13" width="98" height="60" rx="4"/></clipPath></defs>
        <rect x="140" y="13" width="98" height="60" rx="4" class="ink-f"/>
        <g clip-path="url(#mini-tv)">
          <circle class="sun" cx="168" cy="32" r="7" style="fill:var(--term-mark)"/>
          <path d="M138 74 L166 50 L182 62 L200 44 L240 74 Z" style="fill:var(--paper); opacity:.22"/>
        </g>
        <path class="ink" stroke-width="1.8" d="M139.6 13.5 Q189 11.8 238.6 13 Q239.6 43 238.2 73.4 Q189 74.6 140.2 73 Q138.8 43 139.6 13.5 Z"/>
        <path class="soft" d="M142 86 H236"/>
        <rect class="prog mk-f" x="142" y="84.4" width="94" height="3.2" rx="1.6"/>
        <path class="soft" d="M180 78 L184 80.5 L180 83" style="opacity:0"/>
      </svg>
    </span>
    <span class="label"><span class="name">ChalChitra</span><span class="stars">no AVPlayer</span></span>
  </a>
</section>

<style>
/* ---------- the bento ---------- */
.bento {
  /* The terminal is near-black, a shade off the page. */
  --term-bg: #16130d; --term-ink: var(--ink); --term-mark: var(--mark);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: 196px 196px 196px;
  grid-template-areas:
    "neo  neo  blink blink"
    "neo  neo  call  ig"
    "keem chal chal  ig";
  gap: 14px;
}
.bento .t-neo   { grid-area: neo; }
.bento .t-blink { grid-area: blink; }
.bento .t-call  { grid-area: call; }
.bento .t-ig    { grid-area: ig; }
.bento .t-keem  { grid-area: keem; }
.bento .t-chal  { grid-area: chal; }

@media (max-width: 720px) {
  .bento {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 250px 168px 172px 172px 150px;
    grid-template-areas:
      "neo   neo"
      "blink blink"
      "ig    call"
      "ig    keem"
      "chal  chal";
    gap: 10px;
  }
}

.tile {
  all: unset; box-sizing: border-box;
  color: var(--ink); text-decoration: none;
  position: relative; display: flex; flex-direction: column;
  min-width: 0; min-height: 0;
  padding: 12px 14px 12px;
  background: var(--paper-raise);
  border-radius: 14px;
  cursor: pointer;
  container-type: size;
  transition: transform .5s var(--ease-out), background-color .3s;
}
.tile:hover { transform: translateY(-3px) rotate(-.25deg); }
.tile:nth-child(even):hover { transform: translateY(-3px) rotate(.25deg); }
.tile:focus-visible { outline: 2.5px solid var(--mark); outline-offset: 4px; }
.tile:active { transform: translateY(0) scale(.99); }

/* hand-drawn outline: two passes of a wobbly pen */
.frame { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
.frame path { fill: none; stroke: var(--ink); stroke-width: 1.5; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
.frame path + path { stroke-width: .8; opacity: .45; }

:where(.stage span) { display: block; }
.stage { flex: 1; min-height: 0; display: grid; place-items: center; position: relative; }
.stage > svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; overflow: visible; }
.label { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; padding-top: 6px; }
.name { font: 650 1.12rem/1 var(--font-display); letter-spacing: -.01em; }
.stars { font: 500 .78rem/1 var(--font-mono); color: var(--ink-3); white-space: nowrap; }
.stars b { color: var(--mark); font-weight: 600; }
.tile:hover .name { color: var(--mark); }

/* shared svg ink */
.ink   { stroke: var(--ink); fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.ink-f { fill: var(--ink); }
.soft  { stroke: var(--ink-3); fill: none; stroke-width: 1.2; stroke-linecap: round; }
.mk    { stroke: var(--mark); fill: none; stroke-linecap: round; stroke-linejoin: round; }
.mk-f  { fill: var(--mark); }
.sunk  { fill: var(--paper-sunk); }

/* ======================================================================
   1. NeoBrutalism: a hard-shadow button that presses in and out
   Still frame: cursor resting on the button, toggle on.
   ====================================================================== */
.nb { position: relative; width: 264px; height: 188px; }
@container (min-height: 300px) { .nb { scale: 1.4; } }
.nb-card {
  position: absolute; left: 0; top: 4px; width: 150px; height: 92px;
  background: var(--paper); border: 2px solid var(--ink); border-radius: 8px;
  box-shadow: 5px 5px 0 var(--ink); rotate: -2deg;
  padding: 12px;
}
.nb-card i { display: block; height: 7px; border-radius: 4px; background: var(--ink); margin-bottom: 8px; width: 70%; }
.nb-card i:nth-child(2) { width: 92%; opacity: .25; }
.nb-card i:nth-child(3) { width: 54%; opacity: .25; }
.nb-card i:nth-child(4) { position: absolute; right: 12px; bottom: 4px; width: 26px; height: 26px; border-radius: 50%; background: var(--mark); border: 2px solid var(--ink); opacity: 1; }
.nb-btn {
  position: absolute; left: 22px; top: 122px;
  padding: 10px 26px; border-radius: 8px;
  background: var(--mark); color: var(--mark-ink);
  border: 2px solid var(--ink); box-shadow: 5px 5px 0 var(--ink);
  font: 700 1rem/1 var(--font-display); letter-spacing: .01em;
}
.nb-tog {
  position: absolute; left: 184px; top: 40px; width: 56px; height: 30px;
  border: 2px solid var(--ink); border-radius: 99px; background: var(--mark);
  box-shadow: 4px 4px 0 var(--ink);
}
.nb-tog::after {
  content: ""; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px;
  border-radius: 50%; background: var(--paper-raise); border: 2px solid var(--ink);
  translate: 26px 0;
}
.nb-chk {
  position: absolute; left: 196px; top: 104px; width: 30px; height: 30px;
  border: 2px solid var(--ink); border-radius: 6px; background: var(--paper);
  box-shadow: 4px 4px 0 var(--ink); rotate: 3deg;
}
.nb-chk svg { width: 100%; height: 100%; }
.nb-cur { position: absolute; left: 76px; top: 138px; width: 22px; height: 26px; overflow: visible; }
.nb-cur path { fill: var(--paper-raise); stroke: var(--ink); stroke-width: 1.6; stroke-linejoin: round; }

/* ======================================================================
   2. BlinkUI: SwiftUI-style code on the left, the terminal it renders on the
   right. Focus moves to "Red pill", it is pressed, and only the changed
   region is rewritten. This is the demo from the project's own README.
   Still frame: both buttons drawn, "Red pill" focused.
   ====================================================================== */
.bk { display: flex; align-items: center; gap: 12px; }
.bk-code {
  display: none;
  padding: 9px 11px; border-radius: 8px;
  background: var(--paper-sunk); box-shadow: inset 0 0 0 1px var(--rule);
  font: 500 10.5px/1.45 var(--font-mono); color: var(--ink-3); white-space: nowrap;
}
.bk-code b { font-weight: 600; color: var(--ink); }
.bk-code i { font-style: normal; color: var(--mark); }
.bk-arrow { display: none; width: 30px; height: 14px; flex: none; }
@container (min-width: 420px) { .bk-code, .bk-arrow { display: block; } }
@container (min-width: 500px) { .bk { scale: 1.25; } }

.term { width: 196px; padding: 0 10px 10px; background: var(--term-bg); border-radius: 9px; box-shadow: 0 0 0 1.5px var(--ink); flex: none; }
.term-bar { height: 15px; display: flex; gap: 4px; align-items: center; }
.term-bar i { width: 5px; height: 5px; border-radius: 50%; background: rgba(244,236,214,.28); }
.bk-scr { display: grid; gap: 7px; padding: 6px 2px 2px; font: 500 10px/1.2 var(--font-mono); color: var(--term-ink); }
.bk-swap { display: grid; position: relative; min-height: 22px; align-items: center; }
.bk-swap > * { grid-area: 1 / 1; }
.bk-btns { display: flex; gap: 6px; }
.bk-btn { padding: 4px 7px; border: 1px solid rgba(244,236,214,.45); border-radius: 2px; }
.bk-red { background: var(--term-mark); border-color: var(--term-mark); color: var(--term-bg); }
.bk-matrix { visibility: hidden; justify-self: start; padding: 4px 6px; background: #000; color: #e9c46a; }
.bk-dirty { inset: -3px; position: absolute; border: 1px dashed var(--term-mark); border-radius: 3px; opacity: 0; }

/* ======================================================================
   3. NotTheInstagram: the feed scrolls three posts, then stops and makes
   you wait while a ring fills. Still frame: the third post and the wait.
   ====================================================================== */
.ig-feed { transform: translateY(-72px); }
.ig-wait { stroke-dasharray: 1; stroke-dashoffset: .35; }
/* The name is long for a quarter-width tile: the tag goes first, then the
   name breaks after "NotThe", so it never runs past the frame. */
@container (max-width: 230px) { .t-ig .stars { display: none; } }
.t-ig .name { line-height: 1.1; }
/* The same for OneOnOne on a phone, where its tag no longer fits beside it. */
@container (max-width: 170px) { .t-call .stars { display: none; } }

/* ======================================================================
   4. OneOnOne: two peers meet via a server, which then steps aside
   ====================================================================== */
.srv { opacity: .25; }
.direct { stroke-dasharray: 1; stroke-dashoffset: 0; }
.pk { opacity: 0; }
.halo { transform-box: fill-box; transform-origin: 50% 50%; opacity: .45; scale: 1.5; }

/* ======================================================================
   5. keemat: price ticks down, notification dot appears
   ====================================================================== */
.km { width: min(172px, 100%); padding: 12px 14px 10px; border-radius: 12px; background: var(--paper); box-shadow: 0 0 0 1.5px var(--ink); position: relative; }
.km-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
.km-thumb { width: 26px; height: 26px; border-radius: 6px; background: var(--paper-sunk); box-shadow: inset 0 0 0 1.5px var(--ink); position: relative; }
.km-thumb::after { content: ""; position: absolute; inset: 7px 6px 6px; border: 1.5px solid var(--ink); border-top-width: 3px; border-radius: 2px; }
.km-bell { position: relative; width: 18px; height: 18px; }
.km-bell svg { width: 100%; height: 100%; display: block; }
.km-dot { position: absolute; right: -3px; top: -3px; width: 9px; height: 9px; border-radius: 50%; background: var(--mark); box-shadow: 0 0 0 2px var(--paper); }
.km-price { font: 600 1.35rem/1 var(--font-mono); letter-spacing: -.02em; display: flex; align-items: baseline; gap: 2px; }
.km-price small { font-size: .7rem; color: var(--ink-3); text-decoration: line-through; margin-left: 6px; font-weight: 500; }
.km-win { display: inline-block; height: 1.1em; overflow: hidden; vertical-align: bottom; }
.km-roll { display: block; translate: 0 -3.3em; }
.km-roll span { display: block; height: 1.1em; line-height: 1.1em; }
.km-roll span:last-child { color: var(--mark); }
@container (max-width: 210px) { .km-price small { display: none; } .km { padding: 10px 11px 8px; } }
.km-line { display: block; width: 100%; height: 34px; margin-top: 6px; overflow: visible; }
.km-path { stroke-dasharray: 1; stroke-dashoffset: 0; }

/* ======================================================================
   6. ChalChitra: segments stream into a screen, without AVPlayer
   ====================================================================== */
.segbox { transform: translateX(calc(var(--i) * 23px)); }
.prog { transform-box: fill-box; transform-origin: 0 50%; transform: scaleX(.55); }

/* ======================================================================
   Motion. Everything above is the still frame; animation only runs when
   the visitor has not asked for less motion.
   ====================================================================== */
@media (prefers-reduced-motion: no-preference) {
  /* NeoBrutalism, 5.2s */
  .nb-btn { animation: nb-press 5.2s var(--ease-out) infinite; }
  .nb-cur { animation: nb-cursor 5.2s cubic-bezier(.45,0,.2,1) infinite; }
  .nb-tog::after { animation: nb-knob 5.2s var(--ease-out) infinite; }
  .nb-tog { animation: nb-track 5.2s steps(1) infinite; }
  @keyframes nb-press {
    0%, 36%, 54%, 100% { translate: 0 0; box-shadow: 5px 5px 0 var(--ink); }
    41%, 47% { translate: 5px 5px; box-shadow: 0 0 0 var(--ink); }
  }
  @keyframes nb-cursor {
    0%   { translate: 70px 34px; opacity: 0; }
    10%  { opacity: 1; }
    34%  { translate: 0 0; scale: 1; }
    41%, 46% { translate: 3px 3px; scale: .86; }
    52%  { translate: 0 0; scale: 1; }
    74%  { translate: 0 0; opacity: 1; }
    92%, 100% { translate: 70px 34px; opacity: 0; }
  }
  @keyframes nb-knob { 0%, 46% { translate: 0 0; } 54%, 92% { translate: 26px 0; } 100% { translate: 0 0; } }
  @keyframes nb-track { 0% { background: var(--paper); } 50% { background: var(--mark); } 96% { background: var(--paper); } }

  /* BlinkUI, 8s. Terminals do not fade, so every change is a hard step. */
  .bk-blue   { animation: bk-blue 8s steps(1, end) infinite; }
  .bk-red    { animation: bk-red 8s steps(1, end) infinite; }
  .bk-btns   { animation: bk-btns 8s steps(1, end) infinite; }
  .bk-matrix { animation: bk-matrix 8s steps(1, end) infinite; }
  .bk-dirty  { animation: bk-dirty 8s steps(1, end) infinite; }
  @keyframes bk-blue {
    0%  { background: var(--term-ink); border-color: var(--term-ink); color: var(--term-bg); }
    34% { background: transparent; border-color: rgba(244,236,214,.45); color: var(--term-ink); }
  }
  @keyframes bk-red {
    0%  { background: transparent; border-color: rgba(244,236,214,.45); color: var(--term-ink); scale: 1; }
    34% { background: var(--term-mark); border-color: var(--term-mark); color: var(--term-bg); scale: 1; }
    52% { scale: .92; }
    56% { scale: 1; }
  }
  @keyframes bk-btns   { 0% { visibility: visible; } 58% { visibility: hidden; } 94% { visibility: visible; } }
  @keyframes bk-matrix { 0% { visibility: hidden; } 58% { visibility: visible; } 94% { visibility: hidden; } }
  @keyframes bk-dirty  {
    0% { opacity: 0; } 34% { opacity: .9; } 37% { opacity: 0; }
    58% { opacity: 1; } 62% { opacity: 0; } 64% { opacity: 1; } 68% { opacity: 0; }
  }

  /* NotTheInstagram, 8s: scroll, scroll, stop, wait, start over */
  .ig-feed { animation: ig-feed 8s cubic-bezier(.5,0,.2,1) infinite; }
  .ig-wait { animation: ig-wait 8s linear infinite; }
  @keyframes ig-feed {
    0%, 10% { transform: none; opacity: 1; }
    20%, 27% { transform: translateY(-36px); }
    37%, 90% { transform: translateY(-72px); opacity: 1; }
    94% { transform: translateY(-72px); opacity: 0; }
    95% { transform: none; opacity: 0; }
    100% { transform: none; opacity: 1; }
  }
  @keyframes ig-wait { 0%, 38% { stroke-dashoffset: 1; } 86%, 100% { stroke-dashoffset: 0; } }

  /* OneOnOne, 9s */
  .pk-a { animation: pk-a 9s ease-in-out infinite; }
  .pk-b { animation: pk-b 9s ease-in-out infinite; }
  .srv  { animation: srv 9s var(--ease-out) infinite; }
  .direct { animation: direct 9s ease-in-out infinite; }
  .halo { animation: halo 9s ease-out infinite; }
  .halo-b { animation-delay: .15s; }
  @keyframes pk-a {
    0%, 8% { transform: none; opacity: 0; } 10% { opacity: 1; transform: none; }
    22% { transform: translate(68px, -56px); } 34% { transform: translate(136px, 0); opacity: 1; }
    37%, 100% { transform: translate(136px, 0); opacity: 0; }
  }
  @keyframes pk-b {
    0%, 36% { transform: none; opacity: 0; } 38% { opacity: 1; transform: none; }
    48% { transform: translate(-68px, -56px); } 58% { transform: translate(-136px, 0); opacity: 1; }
    61%, 100% { transform: translate(-136px, 0); opacity: 0; }
  }
  @keyframes srv { 0%, 60% { opacity: 1; transform: none; } 70%, 92% { opacity: .25; transform: translateY(-5px); } 100% { opacity: 1; transform: none; } }
  @keyframes direct { 0%, 62% { stroke-dashoffset: 1; } 74%, 94% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 1; } }
  @keyframes halo { 0%, 73% { scale: 1; opacity: 0; } 75% { opacity: .7; scale: 1; } 90% { scale: 2.4; opacity: 0; } 100% { opacity: 0; } }

  /* keemat, 8s */
  .km-roll { animation: tick 8s cubic-bezier(.5,0,.2,1) infinite; }
  .km-path { animation: km-draw 8s linear infinite; }
  .km-end  { animation: km-end 8s ease-out infinite; transform-box: fill-box; transform-origin: 50% 50%; }
  .km-dot  { animation: km-dot 8s var(--ease-out) infinite; }
  @keyframes tick {
    0%, 16% { translate: 0 0; } 21%, 36% { translate: 0 -1.1em; }
    41%, 56% { translate: 0 -2.2em; } 61%, 93% { translate: 0 -3.3em; } 100% { translate: 0 0; }
  }
  @keyframes km-draw { 0%, 4% { stroke-dashoffset: 1; } 64%, 94% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 1; } }
  @keyframes km-end { 0%, 62% { scale: 0; } 68%, 93% { scale: 1; } 100% { scale: 0; } }
  @keyframes km-dot { 0%, 66% { scale: 0; } 71% { scale: 1.45; } 75%, 93% { scale: 1; } 100% { scale: 0; } }

  /* ChalChitra */
  .segbox { animation: stream 7.5s linear infinite; animation-delay: calc(var(--i) * -1.5s); }
  .prog { animation: prog 15s linear infinite; }
  .sun { animation: sun 15s ease-in-out infinite alternate; }
  @keyframes stream {
    0% { transform: translateX(0); opacity: 0; } 8% { opacity: 1; }
    88% { opacity: 1; } 100% { transform: translateX(115px); opacity: 0; }
  }
  @keyframes prog { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes sun { from { transform: translate(0, 0); } to { transform: translate(44px, 10px); } }
}
