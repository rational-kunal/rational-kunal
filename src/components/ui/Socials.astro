---
/** The social links from src/data/site.ts, as a row of round icons. */
import { socials } from '@/data/site';
import { external } from '@/lib/url';
import Icon from './Icon.astro';

interface Props {
  /** Only the links marked `primary`. */
  primaryOnly?: boolean;
  size?: number;
  /** Show each name beside its icon. The footer uses this, so the last thing
      on the page says where to reach me in words, not six bare glyphs. */
  labelled?: boolean;
}
const { primaryOnly = false, size = 18, labelled = false } = Astro.props;

const list = primaryOnly ? socials.filter((s) => s.primary) : socials;
---

<ul class:list={['socials', { 'socials--labelled': labelled }]}>
  {list.map((s) => (
    <li>
      <a class="socials__item" href={s.href} {...external(s.href, 'me noopener')}>
        <Icon name={s.icon} brand={s.brand} size={s.brand ? size * 0.8 : size} />
        <span class:list={[{ 'visually-hidden': !labelled }]}>{s.label}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .socials { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 0; }
  .socials__item {
    display: grid;
    place-items: center;
    width: 2.35rem; height: 2.35rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--rule-soft);
    color: var(--ink-2);
    transition:
      color var(--dur-1) var(--ease),
      border-color var(--dur-1) var(--ease),
      background var(--dur-1) var(--ease);
  }
  /* The pill stays exactly where it is. It used to lift 2px on hover, which
     slid its bottom edge out from under the cursor: hover a pill low down and
     it jumped up, lost the hover, dropped back, and flickered. Now only its
     surface and its icon respond. */
  .socials__item :global(svg) {
    flex: none;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .socials__item:hover,
  .socials__item:focus-visible {
    color: var(--mark);
    border-color: color-mix(in srgb, var(--mark) 45%, transparent);
    background: var(--mark-wash);
  }
  .socials__item:active { background: color-mix(in srgb, var(--mark) 20%, transparent); }
  @media (prefers-reduced-motion: no-preference) {
    .socials__item:hover :global(svg) { transform: scale(1.18) rotate(-6deg); }
  }
  .socials--labelled { gap: 0.5rem; }
  .socials--labelled .socials__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: auto;
    padding: 0 0.95rem 0 0.75rem;
    font-size: var(--t-small);
    text-decoration: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .socials__item, .socials__item :global(svg) { transition: none; }
  }
</style>
