---
/**
 * Icons are read out of the installed packages at build time and inlined.
 * No icon font and no runtime are shipped.
 *
 * Phosphor Light for everything it carries, so the stroke weight stays
 * consistent. `weight="fill"` is the one exception, for a glyph that has to
 * read as lit (the star count). `brand` pulls a logo from Simple Icons
 * instead, for the ones Phosphor does not have (dev.to, Codeforces, most of
 * the skills).
 */
import fs from 'node:fs';
import { createRequire } from 'node:module';

interface Props {
  name: string;
  brand?: boolean;
  size?: number;
  weight?: 'light' | 'fill';
}
const { name, brand = false, size = 18, weight = 'light' } = Astro.props;

const spec = brand
  ? `simple-icons/icons/${name}.svg`
  : `@phosphor-icons/core/assets/${weight}/${name}-${weight}.svg`;

let file: string;
try {
  file = createRequire(import.meta.url).resolve(spec);
} catch {
  throw new Error(
    `Icon "${name}" not found. Expected ${spec}. ` +
      (brand
        ? 'Check the slug at simpleicons.org.'
        : 'Check the name at phosphoricons.com (the "-light" suffix is added for you).'),
  );
}

const raw = fs.readFileSync(file, 'utf8');
const viewBox = raw.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 256 256';
const inner = raw
  .replace(/^[\s\S]*?<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .replace(/<title>[\s\S]*?<\/title>/g, '');
---

<svg
  data-icon={name}
  width={size}
  height={size}
  viewBox={viewBox}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  set:html={inner}
/>
