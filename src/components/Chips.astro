---
interface Props { items: readonly string[]; class?: string; }
const { items, class: klass = '' } = Astro.props;
---
<ul class={`chips ${klass}`}>
  {items.map((i) => <li class="chip">{i}</li>)}
</ul>
<style>
  .chips { display: flex; flex-wrap: wrap; gap: 0.35rem; list-style: none; padding: 0; margin: 0; }
  .chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: -0.01em;
    color: var(--ink-2);
    padding: 0.26rem 0.6rem;
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-pill);
    background: var(--shell);
    white-space: nowrap;
  }
</style>
