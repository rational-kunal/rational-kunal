---
import { socials, type SocialLink } from '@/data/site';
import Icon from './Icon.astro';

interface Props {
  /** Only the links marked `primary` in src/data/site.ts. */
  primaryOnly?: boolean;
  size?: number;
  class?: string;
}
const { primaryOnly = false, size = 18, class: klass = '' } = Astro.props;

const icons: Record<SocialLink['icon'], { name: string; brand?: boolean }> = {
  github:   { name: 'github-logo' },
  devto:    { name: 'devdotto', brand: true },
  linkedin: { name: 'linkedin-logo' },
  x:        { name: 'x-logo' },
  mail:     { name: 'envelope-simple' },
  rss:      { name: 'rss-simple' },
};

const list = socials.filter((s) => (primaryOnly ? s.primary : true));

/* A link without a URL is a placeholder. It shows while developing, so it is
   impossible to forget, and is dropped from the built site so visitors never
   meet a dead icon. See the TODO block in src/data/site.ts. */
const shown = import.meta.env.DEV ? list : list.filter((s) => !s.todo);
---

<ul class={`socials ${klass}`}>
  {shown.map((s) => (
    <li>
      {s.todo ? (
        <span class="socials__item is-todo" title={`TODO: set the ${s.label} URL in src/data/site.ts`}>
          <Icon name={icons[s.icon].name} brand={icons[s.icon].brand} size={icons[s.icon].brand ? size * 0.8 : size} />
          <span class="visually-hidden">{s.label}, link not set yet</span>
        </span>
      ) : (
        <a
          class="socials__item"
          href={s.href}
          rel={s.href.startsWith('http') ? 'me noopener' : undefined}
          target={s.href.startsWith('http') ? '_blank' : undefined}
        >
          <Icon name={icons[s.icon].name} brand={icons[s.icon].brand} size={icons[s.icon].brand ? size * 0.8 : size} />
          <span class="visually-hidden">{s.label}</span>
        </a>
      )}
    </li>
  ))}
</ul>

<style>
  .socials { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 0; }
  .socials__item {
    display: grid;
    place-items: center;
    width: 2.35rem; height: 2.35rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--rule-soft);
    color: var(--ink-2);
    transition:
      color var(--dur-1) var(--ease),
      border-color var(--dur-1) var(--ease),
      background var(--dur-1) var(--ease),
      transform var(--dur-1) var(--ease);
  }
  a.socials__item:hover {
    color: var(--mark);
    border-color: var(--rule);
    background: var(--mark-wash);
    transform: translateY(-2px);
  }
  .is-todo {
    border-style: dashed;
    border-color: var(--mark);
    color: var(--mark);
    opacity: 0.6;
    cursor: help;
  }
  @media (prefers-reduced-motion: reduce) {
    .socials__item { transition: none; }
    a.socials__item:hover { transform: none; }
  }
</style>
