---
/**
 * Drawn graph paper, for a card with no picture of its own. Generated at build
 * time from the same wobble engine as the diagrams, so it is the site's own
 * texture rather than a stock gradient.
 */
import { roughLine, seeds } from '@/lib/rough';

interface Props { seed?: number; }
const { seed = 909 } = Astro.props;

const GAP = 26, W = 420, H = 320;
const next = seeds(seed);
const pen = { wobble: 1.1, passes: 1 };

const lines: string[] = [];
for (let x = GAP; x < W; x += GAP) lines.push(roughLine(x, -4, x, H + 4, next(), pen));
for (let y = GAP; y < H; y += GAP) lines.push(roughLine(-4, y, W + 4, y, next(), pen));
---
<svg class="paper-grid" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  {lines.map((d) => <path d={d} />)}
</svg>
<style>
  .paper-grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.4;
  }
  .paper-grid path { stroke: var(--ink-3); stroke-width: 0.8; fill: none; opacity: 0.35; }
</style>
