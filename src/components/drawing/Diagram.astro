---
/**
 * Renders a Diagram spec (src/data/diagrams.ts) as hand-drawn SVG.
 *
 * Every path is generated here, during the build, from a seeded wobble. The
 * browser receives finished SVG: no drawing library, no script, no bundle.
 * The caption is not printed; it is the svg's <desc> for screen readers.
 */
import { roughRect, roughLine, roughArrow, roughHatch, roughCross, seeds } from '@/lib/rough';
import { routeEdge, labelSpot, type Diagram } from '@/lib/diagram';

interface Props {
  diagram: Diagram;
  /** What the figure is called, for screen readers. */
  title: string;
  class?: string;
}
const { diagram: spec, title, class: klass } = Astro.props;

const byId = new Map(spec.nodes.map((n) => [n.id, n]));
const uid = `dg-${spec.seed}`;
const nextSeed = seeds(spec.seed);

type Piece = { d: string; cls: 'd-stroke' | 'd-mark' | 'd-faint'; width: number; dashed?: boolean; len: number };
const pieces: Piece[] = [];
const hatches: string[] = [];
const crosses: string[] = [];

/* --- Boxes ------------------------------------------------------------- */
for (const n of spec.nodes) {
  if (n.emphasis) hatches.push(roughHatch(n.x + 3, n.y + 3, n.w - 6, n.h - 6, nextSeed(), 9));
  pieces.push({
    d: roughRect(n.x, n.y, n.w, n.h, nextSeed(), { wobble: n.struck ? 1.3 : 1.9 }),
    cls: n.emphasis ? 'd-mark' : n.struck ? 'd-faint' : 'd-stroke',
    width: n.emphasis ? 1.9 : 1.5,
    len: Math.max(n.w, n.h) + 14,
  });
  if (n.struck) crosses.push(roughCross(n.x, n.y, n.w, n.h, nextSeed()));
}

/* --- Edges: a line per segment, an arrowhead on the last --------------- */
const edgeLabels: { x: number; y: number; text: string; w: number }[] = [];

for (const e of spec.edges) {
  const a = byId.get(e.from);
  const b = byId.get(e.to);
  if (!a || !b) throw new Error(`Diagram ${spec.seed}: unknown node in edge ${e.from} -> ${e.to}`);

  const pts = routeEdge(a, b, e.via);
  let longest = 0;
  for (let i = 0; i < pts.length - 1; i++) {
    const p = pts[i];
    const q = pts[i + 1];
    longest = Math.max(longest, Math.hypot(q.x - p.x, q.y - p.y));
    const draw = i === pts.length - 2 ? roughArrow : roughLine;
    pieces.push({
      d: draw(p.x, p.y, q.x, q.y, nextSeed(), { wobble: 1.1 }),
      cls: e.accent ? 'd-mark' : 'd-stroke',
      width: 1.45,
      dashed: e.dashed,
      len: longest + 16,
    });
  }

  if (e.label) {
    const at = labelSpot(pts);
    edgeLabels.push({ x: at.x, y: at.y, text: e.label, w: e.label.length * 5.4 + 10 });
  }
}
---

<figure class:list={['fig', klass]}>
  <svg
    class="diagram diagram--draw"
    viewBox={`0 0 ${spec.width} ${spec.height}`}
    role="img"
    aria-labelledby={`${uid}-t ${uid}-d`}
    preserveAspectRatio="xMidYMid meet"
  >
    <title id={`${uid}-t`}>{title}</title>
    <desc id={`${uid}-d`}>{spec.caption}</desc>

    {/* Solid fills sit under the drawn outline so edges never show through. */}
    {spec.nodes.map((n) => <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="4" class="d-fill" />)}

    {hatches.map((d) => <path d={d} class="d-mark" stroke-width="1" opacity="0.26" />)}

    {pieces.map((p) => (
      <path
        d={p.d}
        class={p.cls}
        stroke-width={p.width}
        stroke-dasharray={p.dashed ? '6 5' : undefined}
        style={p.dashed ? undefined : `--len:${Math.round(p.len)}`}
      />
    ))}

    {crosses.map((d) => <path d={d} class="d-faint" stroke-width="1.6" />)}

    {/* Edge labels get a paper chip behind them so they stay readable. */}
    {edgeLabels.map((l) => (
      <>
        <rect x={l.x - l.w / 2} y={l.y - 7} width={l.w} height={14} rx="3" fill="var(--paper-sunk)" />
        <text x={l.x} y={l.y + 3.2} class="d-edge" text-anchor="middle">{l.text}</text>
      </>
    ))}

    {spec.nodes.map((n) => {
      const cx = n.x + n.w / 2;
      const cy = n.y + n.h / 2;
      return (
        <>
          <text
            x={cx}
            y={n.sub ? cy - 1 : cy + 4}
            class={`d-label${n.emphasis ? ' d-accent-text' : ''}`}
            text-anchor="middle"
            opacity={n.struck ? 0.55 : 1}
          >{n.label}</text>
          {n.sub && <text x={cx} y={cy + 14} class="d-sub" text-anchor="middle">{n.sub}</text>}
        </>
      );
    })}

    {(spec.notes ?? []).map((nt) => (
      <text x={nt.x} y={nt.y} class="d-note" text-anchor={nt.anchor ?? 'middle'}>{nt.text}</text>
    ))}
  </svg>
</figure>

<style>
  .fig { margin: 0; display: grid; }
  .fig > svg { align-self: center; justify-self: center; }

  /* On a phone the drawing would shrink its labels to about five pixels. It
     keeps a readable size instead and pans sideways. */
  @media (max-width: 640px) {
    .fig { overflow-x: auto; overscroll-behavior-x: contain; }
    .fig > svg { min-width: 34rem; justify-self: start; }
  }
</style>
