---
import { fmtDate, isoDate, url } from '@/lib/url';
import Icon from './Icon.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  published: Date;
  minutes: number;
  tags?: string[];
}
const { href, title, description, published, minutes, tags = [] } = Astro.props;
---

<a class="row reveal" href={url(href)}>
  <div class="row__meta">
    <time class="meta" datetime={isoDate(published)}>{fmtDate(published)}</time>
    <span class="meta">{minutes} min</span>
  </div>
  <div class="row__main">
    <h3 class="row__title">{title}</h3>
    <p class="row__desc">{description}</p>
    {tags.length > 0 && (
      <ul class="row__tags">{tags.map((t) => <li>{t}</li>)}</ul>
    )}
  </div>
  <span class="row__go" aria-hidden="true"><Icon name="arrow-right" size={15} /></span>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) 2.4rem;
    gap: 1.5rem;
    align-items: start;
    padding: 1.6rem 0.9rem 1.6rem 0.9rem;
    margin-inline: -0.9rem;
    border-radius: var(--r-core);
    border-bottom: 1px solid var(--rule-soft);
    text-decoration: none;
    transition: background var(--dur-2) var(--ease);
  }
  .row:hover { background: var(--shell); }

  .row__meta { display: grid; gap: 0.25rem; padding-top: 0.28rem; }
  .row__title {
    font-size: clamp(1.1rem, 1rem + 0.7vw, 1.4rem);
    font-weight: 550;
    letter-spacing: -0.025em;
    line-height: 1.22;
  }
  .row:hover .row__title { color: var(--mark); }
  .row__desc { color: var(--ink-2); font-size: var(--t-small); margin-top: 0.4rem; line-height: 1.62; max-width: 62ch; }
  .row__tags {
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    list-style: none; padding: 0; margin-top: 0.7rem;
  }
  .row__tags li {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-3);
  }
  .row__tags li::before { content: '#'; opacity: 0.6; }

  .row__go {
    display: grid; place-items: center;
    width: 2.1rem; height: 2.1rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--rule-soft);
    color: var(--ink-3);
    margin-top: 0.15rem;
    transition: transform var(--dur-2) var(--ease), color var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease);
  }
  .row:hover .row__go { transform: translateX(3px); color: var(--mark); border-color: var(--mark); }

  @media (max-width: 720px) {
    .row { grid-template-columns: minmax(0, 1fr) 2.1rem; gap: 0.9rem; }
    .row__meta { grid-column: 1 / -1; grid-auto-flow: column; justify-content: start; gap: 0.9rem; padding-top: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .row, .row__go { transition: none; }
    .row:hover .row__go { transform: none; }
  }
</style>
