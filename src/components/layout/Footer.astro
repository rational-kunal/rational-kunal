---
import { site, nav } from '@/data/site';
import { url } from '@/lib/url';
import Socials from '@/components/ui/Socials.astro';
import Icon from '@/components/ui/Icon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="wrap">
    <hr class="rule" />
    <div class="foot">
      <div class="foot__lead">
        {site.openToWork && (
          <p class="foot__line">
            Open to work that needs depth on the client and curiosity everywhere else.
          </p>
        )}
        <Socials labelled size={16} />
      </div>

      <nav class="foot__nav" aria-label="Footer">
        <ul>
          {nav.map((i) => <li><a href={url(i.href)}>{i.label}</a></li>)}
          <li><a href={url('/rss.xml')}>RSS</a></li>
        </ul>
      </nav>
    </div>

    <div class="foot__base">
      <span class="meta">{site.name} &middot; {year}</span>
      <span class="meta foot__made">
        Built with
        <Icon name="heart" size={12} />
        and a little AI
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-bottom: 3rem; }
  .rule { margin-bottom: 2.5rem; }

  .foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2.5rem;
    align-items: start;
  }
  .foot__lead { display: grid; gap: 1.1rem; justify-items: start; }
  .foot__line {
    font-size: clamp(1.1rem, 1rem + 0.9vw, 1.5rem);
    letter-spacing: -0.022em;
    max-width: 22ch;
    line-height: 1.3;
  }

  .foot__nav ul {
    display: grid;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .foot__nav a {
    font-size: var(--t-small);
    color: var(--ink-2);
    text-decoration: none;
  }
  .foot__nav a:hover { color: var(--mark); }

  .foot__base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule-soft);
  }
  .foot__made {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  /* The one splash of colour down here: a lit heart, with a slow beat. */
  .foot__made :global(svg) { color: var(--mark); }
  @media (prefers-reduced-motion: no-preference) {
    .foot__made :global(svg) { animation: beat 2.8s var(--ease-out) infinite; transform-origin: center; }
  }
  @keyframes beat {
    0%, 70%, 100% { transform: scale(1); }
    78%           { transform: scale(1.22); }
    86%           { transform: scale(1); }
    92%           { transform: scale(1.14); }
  }

  @media (max-width: 620px) {
    .foot { grid-template-columns: 1fr; gap: 2rem; }
    .foot__nav ul { grid-template-columns: 1fr 1fr; }
  }
</style>
