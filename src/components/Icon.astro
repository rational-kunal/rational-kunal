---
/**
 * Icons are read out of the installed packages at build time and inlined.
 * Nothing is drawn by hand here, and no icon font or runtime is shipped.
 *
 * Family: Phosphor Light for everything, including the social logos, so the
 * stroke weight stays consistent. Simple Icons is used only for `devdotto`,
 * which Phosphor does not carry.
 */
import fs from 'node:fs';
import { createRequire } from 'node:module';

const require = createRequire(import.meta.url);

interface Props {
  name: string;
  /** Pull from Simple Icons instead of Phosphor. Only needed for dev.to. */
  brand?: boolean;
  size?: number | string;
  class?: string;
}

const { name, brand = false, size = 18, class: cls = '' } = Astro.props;

const spec = brand
  ? `simple-icons/icons/${name}.svg`
  : `@phosphor-icons/core/assets/light/${name}-light.svg`;

let file: string;
try {
  file = require.resolve(spec);
} catch {
  throw new Error(
    `Icon "${name}" not found. Expected ${spec}. ` +
    (brand
      ? 'Check the slug at simple-icons.org.'
      : 'Check the name at phosphoricons.com (the "-light" suffix is added for you).'),
  );
}

const raw = fs.readFileSync(file, 'utf8');
const viewBox = raw.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 256 256';
const inner = raw
  .replace(/^[\s\S]*?<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .replace(/<title>[\s\S]*?<\/title>/g, '');
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox={viewBox}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  set:html={inner}
/>
