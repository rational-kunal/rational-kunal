---
/**
 * A real screenshot from the project's own repository.
 *
 * Dark variants are swapped by the browser through <picture>, so there is no
 * flash and no script. `fit="crop"` is for small surfaces: it shows the top of
 * a tall phone screenshot rather than shrinking the whole thing to nothing.
 */
import { url } from '@/lib/url';

interface Props {
  src: string;
  dark?: string;
  alt: string;
  fit?: 'crop' | 'full';
  class?: string;
}
const { src, dark, alt, fit = 'crop', class: klass = '' } = Astro.props;
---

<figure class={`shotfig shotfig--${fit} plate plate--sunk ${klass}`}>
  <div class="plate__core shotfig__core">
    <picture>
      {dark && <source media="(prefers-color-scheme: dark)" srcset={url(dark)} />}
      <img src={url(src)} alt={alt} loading="lazy" decoding="async" />
    </picture>
  </div>
</figure>

<style>
  .shotfig { margin: 0; }
  .shotfig__core { overflow: hidden; padding: 0; }
  .shotfig picture { display: block; }
  .shotfig img {
    width: 100%;
    display: block;
    border-radius: calc(var(--r-core) - 1px);
  }
  /* Small surfaces: show the top of the screen, which is where the app is. */
  .shotfig--crop img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top center;
  }
  .shotfig--full img { height: auto; }
</style>
