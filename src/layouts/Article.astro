---
/**
 * One article, laid out like an annotated page: the text in one column, a
 * margin on the right for handwritten notes, and hand-drawn strokes (this
 * title's underline here, the rest from src/lib/scribbles.ts).
 */
import '@fontsource/shantell-sans/500.css';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/data/site';
import { projects, projectHref } from '@/data/projects';
import { minutesOf, type Post } from '@/lib/content';
import { fmtDate, isoDate } from '@/lib/dates';
import { roughLine, seedOf } from '@/lib/rough';
import { absolute, url } from '@/lib/url';

interface Props { post: Post; }
const { post } = Astro.props;
const { title, description, published, updated, tags, devto, ai } = post.data;

const underline = roughLine(4, 11, 596, 7, seedOf(post.id), { wobble: 3 });

/* A reader who lands here from a search should find the project too. The link
   is the same one a project card makes to its write-up, read the other way. */
const project = projects.find((p) => p.article === post.id);

const image = `/og/writing/${post.id}.png`;
const here = new URL(Astro.url.pathname, Astro.site).href;

/* Structured data, so a search result can show the date and the author. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: isoDate(published),
  dateModified: isoDate(updated ?? published),
  url: here,
  mainEntityOfPage: here,
  image: absolute(image),
  keywords: tags.join(', ') || undefined,
  author: { '@type': 'Person', name: site.name, url: absolute('/') },
};
---

<Base
  title={title}
  description={description}
  type="article"
  publishedTime={isoDate(published)}
  image={image}
  imageAlt={`${title}, by ${site.name}`}
  jsonLd={jsonLd}
>
  <article class="article wrap">
    <header class="article__head">
      <a class="article__back" href={url('/#writing')}>
        <Icon name="arrow-right" size={13} />
        All writing
      </a>

      <h1 class="h1 article__title">{title}</h1>
      <svg class="article__under scribble" viewBox="0 0 600 18" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d={underline} />
      </svg>

      <p class="article__stand">{description}</p>

      <div class="article__meta">
        <time class="meta" datetime={isoDate(published)}>{fmtDate(published)}</time>
        <span class="meta">{minutesOf(post)} min read</span>
        {updated && <span class="meta">updated {fmtDate(updated)}</span>}
        {tags.length > 0 && (
          <ul class="article__tags">{tags.map((t) => <li>#{t}</li>)}</ul>
        )}
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="article__foot">
      <hr class="rule" />
      {project && (
        <p class="article__proj">
          Related project: <a class="link" href={url(projectHref(project))}>{project.name}</a>,
          with its source and a drawing of how it works.
        </p>
      )}
      <div class="article__footrow">
        <p class="article__by">
          Written by {site.name}{ai && ', with help from AI'}.
          {devto && (
            <>
              {' '}It is also on <a class="link" href={devto} rel="noopener" target="_blank">dev.to</a>.
            </>
          )}
        </p>
        <a class="btn" href={url('/#writing')}>
          More writing
          <span class="btn__cap" aria-hidden="true"><Icon name="arrow-right" size={13} /></span>
        </a>
      </div>
    </footer>
  </article>
</Base>

<style>
  /* Reading width, centred. From 1140px (where global.css, "Annotated article",
     opens the note margin) it widens to hold the column plus that margin, and
     the column stays left. */
  .article { max-width: 760px; padding-top: clamp(2rem, 1.5rem + 3vw, 3.5rem); }
  @media (min-width: 1140px) { .article { max-width: 1140px; } }
  .article__head { display: grid; justify-items: start; margin-bottom: 3rem; }

  .article__back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--t-small);
    color: var(--ink-3);
    text-decoration: none;
    margin-bottom: 1.5rem;
  }
  .article__back:hover { color: var(--mark); }
  /* The right arrow, turned round. Translating after the rotation moves it in
     the rotated frame, so on hover it steps left, the way it points. */
  .article__back :global(svg) {
    transform: rotate(180deg);
    transition: transform var(--dur-2) var(--ease-out);
  }
  .article__back:hover :global(svg) { transform: rotate(180deg) translateX(2px); }
  @media (prefers-reduced-motion: reduce) {
    .article__back :global(svg) { transition: none; }
    .article__back:hover :global(svg) { transform: rotate(180deg); }
  }

  .article__title {
    font-size: clamp(2.3rem, 1.2rem + 3.6vw, 4.2rem);
    line-height: 1.03;
    letter-spacing: -0.032em;
    max-width: 17ch;
    text-wrap: balance;
  }
  /* Drawn under the title, a little short of the column, the way a pen stops. */
  .article__under { width: min(100%, 540px); height: 18px; margin-top: 0.45rem; }
  .article__under path { stroke-width: 2.6; }
  .article__stand {
    margin-top: 1.3rem;
    max-width: 46ch;
    font-size: clamp(1.08rem, 1rem + 0.45vw, 1.3rem);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .article__meta { display: flex; align-items: baseline; gap: 0.5rem 1rem; flex-wrap: wrap; margin-top: 1.3rem; }
  .article__tags {
    display: flex; gap: 0.7rem; flex-wrap: wrap;
    list-style: none; padding: 0; margin: 0;
  }
  .article__tags li { font-family: var(--font-mono); font-size: 0.7rem; color: var(--ink-3); }

  /* Room under the byline, so the page does not run straight into the site footer. */
  .article__foot { max-width: var(--measure); margin-top: 3.5rem; padding-bottom: clamp(3.5rem, 2.5rem + 5vw, 6rem); }
  .article__foot .rule { margin-bottom: 1.8rem; }
  .article__proj { margin: 0 0 1.4rem; color: var(--ink-2); }
  .article__footrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .article__by { font-size: var(--t-small); color: var(--ink-2); }
</style>
