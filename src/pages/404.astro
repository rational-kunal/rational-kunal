---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/ui/Icon.astro';
import { roughRect, roughArrow } from '@/lib/rough';
import { url } from '@/lib/url';

/* A drawing, because that is what the rest of the site does when something
   needs explaining. Here the arrow points at a box that is simply not there. */
const box = roughRect(14, 22, 150, 64, 4242, { wobble: 1.9 });
const gone = roughRect(236, 22, 150, 64, 777, { wobble: 1.3 });
const arrow = roughArrow(164, 54, 236, 54, 991, { wobble: 1.1 });
---

<Base title="Not found" description="That page does not exist.">
  <section class="lost">
    <div class="wrap lost__wrap">
      <p class="eyebrow">404</p>
      <h1 class="h1 lost__head">That page is not here.</h1>
      <p class="lede">
        The link is either old or was never right. The work and the writing are
        both still where they should be.
      </p>

      <svg class="diagram lost__fig" viewBox="0 0 400 110" role="img" aria-label="A link pointing at a page that does not exist.">
        <rect x="14" y="22" width="150" height="64" rx="4" class="d-fill" />
        <path d={box} class="d-stroke" stroke-width="1.6" />
        <text x="89" y="58" class="d-label" text-anchor="middle">the link</text>
        <path d={arrow} class="d-mark" stroke-width="1.5" />
        <path d={gone} class="d-faint" stroke-width="1.4" stroke-dasharray="6 5" />
        <text x="311" y="58" class="d-label" text-anchor="middle" opacity="0.5">nothing</text>
        <text x="200" y="102" class="d-note" text-anchor="middle">this is the whole bug</text>
      </svg>

      <div class="lost__acts">
        <a class="btn btn--solid" href={url('/')}>
          Back to the start
          <span class="btn__cap" aria-hidden="true"><Icon name="arrow-right" size={13} /></span>
        </a>
        <a class="btn" href={url('/#work')}>
          See the work
          <span class="btn__cap" aria-hidden="true"><Icon name="arrow-right" size={13} /></span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost { min-height: 62dvh; display: grid; place-items: center; padding-block: clamp(3rem, 8vw, 7rem); }
  .lost__wrap { display: grid; justify-items: start; gap: 1.2rem; max-width: 640px; }
  .lost__head { max-width: 16ch; }
  .lost__fig { max-width: 400px; margin-block: 0.8rem; }
  .lost__acts { display: flex; gap: 0.6rem; flex-wrap: wrap; }
</style>
