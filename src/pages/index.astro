---
/**
 * The whole site is this one page, in this order: what I built, what I can
 * do (right after the evidence), what I wrote, and who I am.
 */
import Base from '@/layouts/Base.astro';
import Hero from '@/components/home/Hero.astro';
import Work from '@/components/home/Work.astro';
import Skills from '@/components/home/Skills.astro';
import Writing from '@/components/home/Writing.astro';
import About from '@/components/home/About.astro';
import { site, socials } from '@/data/site';
import { absolute, isExternal } from '@/lib/url';

/* Who this page is about, for search engines: the name, the job, and the
   profiles that are the same person. */
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.handle,
  jobTitle: site.role,
  description: site.description,
  url: absolute('/'),
  image: absolute(site.avatar),
  sameAs: socials.map((s) => s.href).filter(isExternal),
};
---

<Base jsonLd={person}>
  <Hero />
  <Work />
  <Skills />
  <Writing />
  <About />
</Base>
