---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHead from '@/components/PageHead.astro';
import ArticleRow from '@/components/ArticleRow.astro';
import TodoBanner from '@/components/TodoBanner.astro';
import Icon from '@/components/Icon.astro';
import { readingMinutes, url } from '@/lib/url';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

/* Grouped by year, so an archive reads as a timeline instead of a long list. */
const years = [...new Set(posts.map((p) => p.data.published.getFullYear()))]
  .sort((a, b) => b - a);
---

<Base
  title="Writing"
  description="Short technical pieces about Swift, iOS, terminals and taking things apart."
>
  <TodoBanner />

  <PageHead
    title="Things I worked out, written down."
    lede="Mostly Swift and iOS, occasionally a browser or a terminal. Short pieces, real code, no preamble."
  >
    <a class="btn" href={url('/rss.xml')}>
      Subscribe
      <span class="btn__cap" aria-hidden="true"><Icon name="rss-simple" size={13} /></span>
    </a>
  </PageHead>

  <section class="section">
    <div class="wrap">
      {years.map((year) => (
        <section class="year">
          <h2 class="year__label mono">{year}</h2>
          <div class="year__list">
            {posts
              .filter((p) => p.data.published.getFullYear() === year)
              .map((post) => (
                <ArticleRow
                  href={`/writing/${post.id}`}
                  title={post.data.title}
                  description={post.data.description}
                  published={post.data.published}
                  minutes={post.data.readingTime ?? readingMinutes(post.body ?? '')}
                  tags={post.data.tags}
                />
              ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</Base>

<style>
  .year {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-top: 2.5rem;
  }
  .year:first-child { padding-top: 0; }
  .year__label {
    font-size: 0.8rem;
    color: var(--ink-3);
    position: sticky;
    top: 5.5rem;
    align-self: start;
    letter-spacing: 0.04em;
  }
  .year__list { border-top: 1px solid var(--rule-soft); }

  @media (max-width: 760px) {
    .year { grid-template-columns: 1fr; gap: 0.6rem; }
    .year__label { position: static; }
  }
</style>
